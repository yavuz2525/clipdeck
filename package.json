{
  "name": "clipdeck",
  "version": "0.1.0",
  "description": "A fast, private, open-source clipboard history manager for Windows, macOS and Linux.",
  "main": "main.js",
  "author": "Yavuz Cingöz",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/history-store.js && node --check src/renderer/app.js",
    "test": "node --test",
    "package": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "electron",
    "productivity",
    "open-source"
  ],
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "io.github.yavuz2525.clipdeck",
    "productName": "ClipDeck",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClipDeck-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipDeck",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yavuz2525",
        "repo": "clipdeck"
      }
    ]
  }
}
