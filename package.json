{
  "name": "clipdeck",
  "version": "0.5.2",
  "description": "A fast, private, open-source clipboard history manager for Windows, macOS and Linux.",
  "main": "main.js",
  "author": "Yavuz Cingöz",
  "license": "MIT",
  "private": false,
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.js",
    "prestart": "npm run brand:generate",
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check scripts/generate-brand-assets.js && node --check src/history-store.js && node --check src/snippet-store.js && node --check src/password-generator.js && node --check src/vault-store.js && node --check src/renderer/app.js && node --check src/quick/app.js",
    "test": "node --test",
    "prepackage": "npm run brand:generate",
    "package": "electron-builder --dir --publish never",
    "predist:win": "npm run brand:generate",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "electron",
    "productivity",
    "open-source"
  ],
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "io.github.yavuz2525.clipdeck",
    "productName": "ClipDeck",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClipDeck-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipDeck",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yavuz2525",
        "repo": "clipdeck"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
